/*
 * Enable USART2 on PD5 (TX) / PD6 (RX) for PPP link.
 * Cross-connect TX/RX between two boards (Board A PD5 → Board B PD6, etc).
 */

&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/ {
	chosen {
		zephyr,ppp-uart = &usart2;
	};
};
